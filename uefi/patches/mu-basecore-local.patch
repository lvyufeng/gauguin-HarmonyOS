diff --git a/MdeModulePkg/Core/Dxe/Dispatcher/Dispatcher.c b/MdeModulePkg/Core/Dxe/Dispatcher/Dispatcher.c
index d7c7147e..81c48f26 100644
--- a/MdeModulePkg/Core/Dxe/Dispatcher/Dispatcher.c
+++ b/MdeModulePkg/Core/Dxe/Dispatcher/Dispatcher.c
@@ -60,6 +60,52 @@ EFI_LOCK  mDispatcherLock = EFI_INITIALIZE_LOCK_VARIABLE (TPL_HIGH_LEVEL);
 //
 BOOLEAN  gDispatcherRunning = FALSE;
 
+//
+// P2BRINGUP: temporary bring-up instrumentation. Remove this whole block once
+// DXE reaches BDS.
+//
+// The dispatcher has two failure paths that leave no trace at all: a driver
+// whose CoreLoadImage fails is marked Initialized and skipped, and a driver
+// whose EntryPoint returns an error has its status discarded by the caller of
+// CoreStartImage. Neither prints anything reachable from the framebuffer
+// console, which is the only console a DEBUG build has here, so a driver that
+// cannot be dispatched and a driver that was dispatched and gave up look
+// identical: the architectural protocol it owes is simply never installed.
+// These counters and records are printed by CoreDisplayDiscoveredNotDispatched,
+// which DxeMain runs immediately before the "arch protocol not present" assert
+// - i.e. while the evidence is still the last thing on the panel.
+//
+#define P2BRINGUP_DIAG_MAX  64
+
+typedef struct {
+  EFI_GUID      Guid;
+  EFI_STATUS    Status;
+  CHAR8         Phase;      // 'L' = CoreLoadImage failed, 'S' = CoreStartImage failed
+} P2BRINGUP_DIAG;
+
+STATIC P2BRINGUP_DIAG  mP2Diag[P2BRINGUP_DIAG_MAX];
+STATIC UINTN           mP2DiagCount    = 0;   // records written
+STATIC UINTN           mP2Discovered   = 0;   // entries added to mDiscoveredList
+STATIC UINTN           mP2Apriori      = 0;   // entries promoted by an Apriori file
+STATIC UINTN           mP2AprioriCount = 0;   // GUIDs in the largest Apriori file seen
+STATIC UINTN           mP2Started      = 0;   // EntryPoints that returned success
+
+STATIC
+VOID
+P2Record (
+  IN EFI_GUID    *Guid,
+  IN CHAR8       Phase,
+  IN EFI_STATUS  Status
+  )
+{
+  if (mP2DiagCount < P2BRINGUP_DIAG_MAX) {
+    CopyGuid (&mP2Diag[mP2DiagCount].Guid, Guid);
+    mP2Diag[mP2DiagCount].Phase  = Phase;
+    mP2Diag[mP2DiagCount].Status = Status;
+    mP2DiagCount++;
+  }
+}
+
 //
 // Module globals to manage the FwVol registration notification event
 //
@@ -483,6 +529,8 @@ CoreDispatcher (
             DriverEntry->Initialized = TRUE;
           }
 
+          P2Record (&DriverEntry->FileName, 'L', Status);
+
           DriverEntry->Scheduled = FALSE;
           RemoveEntryList (&DriverEntry->ScheduledLink);
 
@@ -519,6 +567,12 @@ CoreDispatcher (
 
         Status = CoreStartImage (DriverEntry->ImageHandle, NULL, NULL);
 
+        if (EFI_ERROR (Status)) {
+          P2Record (&DriverEntry->FileName, 'S', Status);
+        } else {
+          mP2Started++;
+        }
+
         REPORT_STATUS_CODE_WITH_EXTENDED_DATA (
           EFI_PROGRESS_CODE,
           (EFI_SOFTWARE_DXE_CORE | EFI_SW_PC_INIT_END),
@@ -896,6 +950,8 @@ CoreAddToDriverList (
 
   CoreReleaseDispatcherLock ();
 
+  mP2Discovered++;
+
   return EFI_SUCCESS;
 }
 
@@ -1412,6 +1468,7 @@ CoreFwVolEventProtocolNotify (
                         );
     if (!EFI_ERROR (Status)) {
       AprioriEntryCount = SizeOfBuffer / sizeof (EFI_GUID);
+      mP2AprioriCount   = MAX (mP2AprioriCount, AprioriEntryCount);
     } else {
       AprioriEntryCount = 0;
     }
@@ -1433,6 +1490,7 @@ CoreFwVolEventProtocolNotify (
           DriverEntry->Scheduled = TRUE;
           InsertTailList (&mScheduledQueue, &DriverEntry->ScheduledLink);
           CoreReleaseDispatcherLock ();
+          mP2Apriori++;
           DEBUG ((DEBUG_DISPATCH, "Evaluate DXE DEPEX for FFS(%g)\n", &DriverEntry->FileName));
           DEBUG ((DEBUG_DISPATCH, "  RESULT = TRUE (Apriori)\n"));
           break;
@@ -1486,11 +1544,58 @@ CoreDisplayDiscoveredNotDispatched (
 {
   LIST_ENTRY             *Link;
   EFI_CORE_DRIVER_ENTRY  *DriverEntry;
+  UINTN                  Index;
+  UINTN                  NotLoaded;
+  UINTN                  Shown;
+
+  //
+  // P2BRINGUP: the cap keeps this dump from scrolling the lines that matter off
+  // the one screen the framebuffer console keeps. The counts at the end are the
+  // part to read: apriori is how many of the two numbers the Apriori file's
+  // GUID count promoted onto the scheduled queue, and diag is how many drivers
+  // the dispatcher then failed to load or to start.
+  //
+  NotLoaded = 0;
+  Shown     = 0;
 
   for (Link = mDiscoveredList.ForwardLink; Link != &mDiscoveredList; Link = Link->ForwardLink) {
     DriverEntry = CR (Link, EFI_CORE_DRIVER_ENTRY, Link, EFI_CORE_DRIVER_ENTRY_SIGNATURE);
-    if (DriverEntry->Dependent) {
-      DEBUG ((DEBUG_LOAD, "Driver %g was discovered but not loaded!!\n", &DriverEntry->FileName));
+    if (DriverEntry->ImageHandle == NULL) {
+      NotLoaded++;
+      if (Shown < 12) {
+        Shown++;
+        DEBUG ((
+          DEBUG_ERROR,
+          "P2 NOLOAD %g dep=%d sched=%d unt=%d\n",
+          &DriverEntry->FileName,
+          DriverEntry->Dependent,
+          DriverEntry->Scheduled,
+          DriverEntry->Untrusted
+          ));
+      }
     }
   }
+
+  DEBUG ((DEBUG_ERROR, "P2 NOLOAD total=%d shown=%d\n", NotLoaded, Shown));
+
+  for (Index = 0; Index < mP2DiagCount; Index++) {
+    DEBUG ((
+      DEBUG_ERROR,
+      "P2 DIAG %c %g %r\n",
+      mP2Diag[Index].Phase,
+      &mP2Diag[Index].Guid,
+      mP2Diag[Index].Status
+      ));
+  }
+
+  DEBUG ((
+    DEBUG_ERROR,
+    "P2 STATS discovered=%d apriori=%d/%d started=%d diag=%d noload=%d\n",
+    mP2Discovered,
+    mP2Apriori,
+    mP2AprioriCount,
+    mP2Started,
+    mP2DiagCount,
+    NotLoaded
+    ));
 }
