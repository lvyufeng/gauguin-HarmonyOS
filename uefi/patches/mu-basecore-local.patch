diff --git a/MdeModulePkg/Core/Dxe/Dispatcher/Dispatcher.c b/MdeModulePkg/Core/Dxe/Dispatcher/Dispatcher.c
index d7c7147e..fab16910 100644
--- a/MdeModulePkg/Core/Dxe/Dispatcher/Dispatcher.c
+++ b/MdeModulePkg/Core/Dxe/Dispatcher/Dispatcher.c
@@ -60,6 +60,589 @@ EFI_LOCK  mDispatcherLock = EFI_INITIALIZE_LOCK_VARIABLE (TPL_HIGH_LEVEL);
 //
 BOOLEAN  gDispatcherRunning = FALSE;
 
+//
+// P2BRINGUP: temporary bring-up instrumentation. Remove this whole block once
+// DXE reaches BDS.
+//
+// The dispatcher has two failure paths that leave no trace at all: a driver
+// whose CoreLoadImage fails is marked Initialized and skipped, and a driver
+// whose EntryPoint returns an error has its status discarded by the caller of
+// CoreStartImage. Neither prints anything reachable from the framebuffer
+// console, which is the only console a DEBUG build has here, so a driver that
+// cannot be dispatched and a driver that was dispatched and gave up look
+// identical: the architectural protocol it owes is simply never installed.
+// These counters and records are printed by CoreDisplayDiscoveredNotDispatched,
+// which DxeMain runs immediately before the "arch protocol not present" assert
+// - i.e. while the evidence is still the last thing on the panel.
+//
+#define P2BRINGUP_DIAG_MAX  64
+
+typedef struct {
+  EFI_GUID      Guid;
+  EFI_STATUS    Status;
+  CHAR8         Phase;      // 'L' = CoreLoadImage failed, 'S' = CoreStartImage failed
+} P2BRINGUP_DIAG;
+
+STATIC P2BRINGUP_DIAG  mP2Diag[P2BRINGUP_DIAG_MAX];
+STATIC UINTN           mP2DiagCount    = 0;   // records written
+STATIC UINTN           mP2Discovered   = 0;   // entries added to mDiscoveredList
+STATIC UINTN           mP2Apriori      = 0;   // entries promoted by an Apriori file
+STATIC UINTN           mP2AprioriCount = 0;   // GUIDs in the largest Apriori file seen
+STATIC UINTN           mP2Started      = 0;   // EntryPoints that returned success
+
+//
+// P2BRINGUP: one result character per Apriori entry, in promotion order - which
+// is the order the dispatcher drains them in, because the promotion loop appends
+// in INDEX_ORDER and the drain is a FIFO. That makes a single line enough to say
+// WHERE the batch broke, which the per-failure records above cannot: they say
+// what failed but not whether anything after it was ever reached, and "reached
+// and failed" and "never reached" are the two readings that matter here.
+//
+//   '?' promoted, nothing recorded for it - either the drain never got there, or
+//       it got there and left no trace, which is itself the answer if every later
+//       entry is '?' too
+//   's' EntryPoint returned EFI_SUCCESS
+//   'S' EntryPoint returned an error
+//   'L' CoreLoadImage failed, so the EntryPoint was never called. `L` says only
+//       that the load failed; the status behind it is kept in mP2ApriSt and
+//       printed twice more by the digest, as a class letter (P2 WHY, aligned
+//       with this line) and in words (P2 ERR, grouped by status)
+//
+#define P2BRINGUP_APRIORI_MAX  128
+
+STATIC EFI_GUID  mP2AprioriGuid[P2BRINGUP_APRIORI_MAX];
+STATIC CHAR8     mP2AprioriRes[P2BRINGUP_APRIORI_MAX];
+STATIC CHAR8     mP2SeqLine[P2BRINGUP_APRIORI_MAX + 8];
+
+//
+// P2BRINGUP: what the firmware volume walk actually returned, kept per entry in
+// mDxeFileTypes. `seen` is how many files GetNextFile handed back and `iter` how
+// many times it was called, so seen < iter means the walk was still being asked
+// and answering "no more"; a pass that stops at a file the volume really contains
+// is the difference between "the walk ended" and "the walk was cut off", and the
+// last GUID names the file it ended on.
+//
+STATIC UINTN     mP2WalkSeen[8] = { 0 };
+STATIC UINTN     mP2WalkIter[8] = { 0 };
+STATIC UINTN     mP2WalkErr[8]  = { 0 };
+STATIC EFI_GUID  mP2WalkLast[8];
+
+//
+// P2BRINGUP: the Apriori file as the firmware itself read it, and what the
+// promotion loop did with it. The loop's behaviour is fully determined by three
+// values the source cannot state: the size ReadSection returned, the entry count
+// divided out of it, and how far down the array the matches ran. That third one
+// is the whole disagreement - a SEQ of 46 characters is either 46 entries
+// scanned and every one matched, or 70 scanned and 46 matched, and the two are
+// indistinguishable from the SEQ line alone.
+//
+// `bytes` and `sum` are compared against the same section read out of the same
+// image on the host, which tools/fv-census.py prints, so a device reading that
+// disagrees with the host is visible as two numbers and not as an argument.
+// `miss` is the first entry after 0 that matched no discovered driver and
+// first/last bound the run that did match: a contiguous first..last with
+// miss == last + 1 says the array or the discovered list is short, while a miss
+// between two matches says the two disagree about a single GUID.
+//
+STATIC UINTN     mP2ApriBytes      = 0;                  // SizeOfBuffer from ReadSection
+STATIC UINTN     mP2ApriEntries    = 0;                  // SizeOfBuffer / sizeof (EFI_GUID)
+STATIC UINT32    mP2ApriSum        = 0;                  // sum*31+byte over the buffer as read
+STATIC EFI_GUID  mP2ApriFirst;
+STATIC EFI_GUID  mP2ApriLast;
+STATIC UINTN     mP2ApriMatchFirst = (UINTN)-1;          // (UINTN)-1 = no entry matched
+STATIC UINTN     mP2ApriMatchLast  = 0;
+STATIC UINTN     mP2ApriUnhit      = 0;                  // entries that matched no discovered driver
+STATIC UINTN     mP2ApriMiss       = (UINTN)-1;          // (UINTN)-1 = no entry > 0 missed
+STATIC EFI_GUID  mP2ApriMissGuid;
+
+//
+// P2BRINGUP: why each load failed, one character per Apriori entry and aligned
+// with mP2AprioriRes. P2Record collapses every CoreLoadImage failure to 'L',
+// which says *that* 27 loads failed and not why - and why is the remaining
+// question, because EFI_OUT_OF_RESOURCES, EFI_NOT_FOUND and
+// EFI_SECURITY_VIOLATION have no mechanism in common. The letters are status
+// classes:
+//
+//   's' EFI_SUCCESS           'S' EntryPoint failed   '?' never reached
+//   'R' OUT_OF_RESOURCES      'N' NOT_FOUND
+//   'X' SECURITY_VIOLATION    'D' DEVICE_ERROR
+//   'E' LOAD_ERROR            'P' INVALID_PARAMETER
+//   'U' UNSUPPORTED           'O' anything else
+//
+STATIC CHAR8     mP2ApriWhy[P2BRINGUP_APRIORI_MAX];
+STATIC CHAR8     mP2WhyLine[P2BRINGUP_APRIORI_MAX + 8];
+
+//
+// P2BRINGUP: the raw status behind mP2ApriWhy, kept so the digest can print the
+// reason in words instead of only in a letter. The letters and the words are the
+// same information, so this is not a second measurement - it is the same one in
+// a form that survives being read once. See the note above P2 ERR in P2Digest.
+//
+STATIC EFI_STATUS  mP2ApriSt[P2BRINGUP_APRIORI_MAX];
+
+STATIC
+UINTN
+P2LargestAlloc (
+  VOID
+  )
+{
+  STATIC CONST UINTN  Ladder[] = { 4096, 1024, 256, 64, 16, 4, 1 };
+  EFI_PHYSICAL_ADDRESS  Memory;
+  EFI_STATUS            Status;
+  UINTN                 Index;
+
+  for (Index = 0; Index < sizeof (Ladder) / sizeof (Ladder[0]); Index++) {
+    Memory = 0;
+    Status = CoreAllocatePages (AllocateAnyPages, EfiBootServicesData, Ladder[Index], &Memory);
+    if (!EFI_ERROR (Status)) {
+      CoreFreePages (Memory, Ladder[Index]);
+      return Ladder[Index];
+    }
+  }
+
+  return 0;
+}
+
+//
+// P2BRINGUP: the whole reading on one line, printed last.
+//
+// Everything above this is detail. A copy of the digest is about 45 rows against
+// a panel that holds 99, so a reader photographing a phone has to find the two
+// rows that matter among the rest - and that is what four sessions failed to do.
+// Two things make it harder than it looks: the console wipes rather than
+// scrolls, and the widest line in the digest (`P2 RETRY`, 86 to 152 columns) is
+// the one nearest the bottom, so the rows a reader reaches last are the ones
+// most likely to have wrapped.
+//
+// This is one line, printed after everything else, carrying the four facts the
+// phase turns on: how many Apriori entries failed and with what status, which
+// entry failed first, what the page allocator will still satisfy, and the first
+// Apriori entry above 0 that matched nothing. It is bounded at 59 columns
+// against the panel's 90, so it never wraps; being last it is the last populated
+// row in every state, including after a wipe - a wipe lands inside a copy, and
+// the rest of that copy prints from the top of the cleared panel and ends here.
+//
+// `miss` is printed signed on purpose: `mP2ApriMiss` is (UINTN)-1 when nothing
+// above 0 failed to match, so the cast renders that as -1 rather than as a
+// twenty-digit number, and -1 can never be a real index.
+//
+STATIC
+VOID
+P2Key (
+  VOID
+  )
+{
