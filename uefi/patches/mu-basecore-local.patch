     } else {
       AprioriEntryCount = 0;
     }
@@ -1433,6 +1577,12 @@ CoreFwVolEventProtocolNotify (
           DriverEntry->Scheduled = TRUE;
           InsertTailList (&mScheduledQueue, &DriverEntry->ScheduledLink);
           CoreReleaseDispatcherLock ();
+          if (mP2Apriori < P2BRINGUP_APRIORI_MAX) {
+            CopyGuid (&mP2AprioriGuid[mP2Apriori], &DriverEntry->FileName);
+            mP2AprioriRes[mP2Apriori] = '?';
+          }
+
+          mP2Apriori++;
           DEBUG ((DEBUG_DISPATCH, "Evaluate DXE DEPEX for FFS(%g)\n", &DriverEntry->FileName));
           DEBUG ((DEBUG_DISPATCH, "  RESULT = TRUE (Apriori)\n"));
           break;
@@ -1486,11 +1636,103 @@ CoreDisplayDiscoveredNotDispatched (
 {
   LIST_ENTRY             *Link;
   EFI_CORE_DRIVER_ENTRY  *DriverEntry;
+  UINTN                  Index;
+  UINTN                  SeqLen;
+  UINTN                  NotLoaded;
+  UINTN                  Shown;
+
+  //
+  // P2BRINGUP: the caps keep this dump from scrolling the lines that matter off
+  // the one screen the framebuffer console keeps. The last two lines are the
+  // part to read - SEQ is the whole Apriori batch as a string of results, in the
+  // order the dispatcher ran them, and STATS is the totals.
+  //
+  NotLoaded = 0;
+  Shown     = 0;
 
   for (Link = mDiscoveredList.ForwardLink; Link != &mDiscoveredList; Link = Link->ForwardLink) {
     DriverEntry = CR (Link, EFI_CORE_DRIVER_ENTRY, Link, EFI_CORE_DRIVER_ENTRY_SIGNATURE);
-    if (DriverEntry->Dependent) {
-      DEBUG ((DEBUG_LOAD, "Driver %g was discovered but not loaded!!\n", &DriverEntry->FileName));
+    if (DriverEntry->ImageHandle == NULL) {
+      NotLoaded++;
+      if (Shown < 6) {
+        Shown++;
+        DEBUG ((
+          DEBUG_ERROR,
+          "P2 NOLOAD %g dep=%d sched=%d unt=%d\n",
+          &DriverEntry->FileName,
+          DriverEntry->Dependent,
+          DriverEntry->Scheduled,
+          DriverEntry->Untrusted
+          ));
+      }
+    }
+  }
+
+  DEBUG ((DEBUG_ERROR, "P2 NOLOAD total=%d shown=%d\n", NotLoaded, Shown));
+
+  for (Index = 0; Index < mP2DiagCount && Index < 24; Index++) {
+    DEBUG ((
+      DEBUG_ERROR,
+      "P2 DIAG %c %g %r\n",
+      mP2Diag[Index].Phase,
+      &mP2Diag[Index].Guid,
+      mP2Diag[Index].Status
+      ));
+  }
+
+  //
+  // The Apriori batch, one character per entry, in the order it was dispatched.
+  // The first character that is not 's' is where the batch stopped producing
+  // working drivers - everything before it ran, everything after it did not.
+  //
+  SeqLen = mP2Apriori;
+  if (SeqLen > P2BRINGUP_APRIORI_MAX) {
+    SeqLen = P2BRINGUP_APRIORI_MAX;
+  }
+
+  if (SeqLen == 0) {
+    DEBUG ((DEBUG_ERROR, "P2 SEQ (no Apriori entries were promoted)\n"));
+  } else {
+    for (Index = 0; Index < SeqLen; Index++) {
+      mP2SeqLine[Index] = mP2AprioriRes[Index];
     }
+
+    mP2SeqLine[SeqLen] = '\0';
+    DEBUG ((DEBUG_ERROR, "P2 SEQ [%a]\n", mP2SeqLine));
   }
+
+  DEBUG ((
+    DEBUG_ERROR,
+    "P2 STATS discovered=%d apriori=%d/%d started=%d diag=%d noload=%d\n",
+    mP2Discovered,
+    mP2Apriori,
+    mP2AprioriCount,
+    mP2Started,
+    mP2DiagCount,
+    NotLoaded
+    ));
+
+  //
+  // What the volume walk itself returned, one line per entry in mDxeFileTypes,
+  // followed by the largest allocation the page allocator will still satisfy.
+  // The walk lines are the answer to "did discovery stop short, or was there
+  // simply nothing left to promote": seen is the number of files the walk was
+  // handed and last is the last one it saw.
+  //
+  for (Index = 0; Index < sizeof (mP2WalkSeen) / sizeof (mP2WalkSeen[0]); Index++) {
+    if (mP2WalkIter[Index] == 0) {
+      continue;
+    }
+
+    DEBUG ((
+      DEBUG_ERROR,
+      "P2 WALK t=%d seen=%d iter=%d last=%g\n",
+      Index,
+      mP2WalkSeen[Index],
+      mP2WalkIter[Index],
+      &mP2WalkLast[Index]
+      ));
+  }
+
