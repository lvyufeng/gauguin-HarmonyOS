+
+//
+// P2BRINGUP: the record above, printed with the digest. Non-static because the
+// digest is Dispatcher.c's (P2Bins) and this file owns the memory map; the
+// declaration is in DxeMain.h beside the other cross-file prototypes.
+//
+// Two lines and never more, because rows are the scarce thing: the panel holds 99 and
+// a copy of the digest costs 49 (tools/console-budget.py), so a third row here would
+// drop it from two copies on the panel to one. The second line is therefore omitted
+// rather than spelled when there is no image-sized failure to describe, and `n` is
+// left to carry the rest: `n=0` is no terminal FindFreePages failure in the whole run,
+// which is the one answer that puts the fault outside this file - CoreLoadPeImage's
+// other EFI_OUT_OF_RESOURCES is a 200-byte AllocateRuntimePool, and a pool request
+// that size cannot reach FindFreePages unless the pool heads are empty, so `n=0`
+// beside 27 recorded `L`s names the pool. `n` above zero with no second line is
+// terminal failures that were all smaller than four pages, which is a different
+// answer again. Both cost nothing to say.
+//
+VOID
+P2FreeWhyReport (
+  VOID
+  )
+{
+  DEBUG ((
+    DEBUG_ERROR,
+    "P2 FWTY bc=%d bd=%d rt=%d oth=%d n=%d\n",
+    mP2FwTy[0],
+    mP2FwTy[1],
+    mP2FwTy[2],
+    mP2FwTy[3],
+    mP2FwCount
+    ));
+
+  if (!mP2FwSeen) {
+    return;
+  }
+
+  DEBUG ((
+    DEBUG_ERROR,
+    "P2 FWHY t=%d np=%ld a=%d big=%ld raw=%ld free=%ld c=%d\n",
+    mP2FwType,
+    mP2FwPages,
+    mP2FwAlign >> EFI_PAGE_SHIFT,
+    RShiftU64 (mP2FwBig, EFI_PAGE_SHIFT),
+    RShiftU64 (mP2FwRaw, EFI_PAGE_SHIFT),
+    mP2FwFree,
+    mP2FwDesc
+    ));
+}
+
