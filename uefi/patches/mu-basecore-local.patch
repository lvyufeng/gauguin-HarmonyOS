+//
+// P2BRINGUP: why a page allocation failed, described by the free map itself.
+//
+// FindFreePages has four rungs and the third is the whole map. CoreLoadPeImage's
+// only allocation is CoreAllocatePages (AllocateAnyPages, ...) -- every one of the
+// 46 promoted modules has PcdLoadModuleAtFixAddressEnable 0 and RelocationsStripped
+// clear, so Image.c:700-741 leaves that one call and its status is what :741
+// returns. CoreInternalAllocatePages turns AllocateAnyPages into MaxAddress =
+// MAX_ALLOC_ADDRESS (:1305), and that rung is CoreFindFreePagesI (MaxAddress, 0, ...)
+// over every descriptor in gMemoryMap. So a terminal failure is not a statement
+// about a bin or a window: it says this map holds no EfiConventionalMemory
+// descriptor of NumberOfPages at or below MAX_ALLOC_ADDRESS.
+//
+// The `Target & EFI_PAGE_MASK` test at :1033 does not weaken that. Target is
+// DescEnd - (NumberOfBytes - 1) with DescEnd + 1 a multiple of the alignment, hence
+// of EFI_PAGE_SIZE, so for a 4-KiB or 64-KiB alignment Target is always a multiple
+// of 4096; the test can only fire in the one case where no descriptor matched, and
+// then only because Target wraps to -NumberOfBytes + 1. It is the "found nothing"
+// test, not a second filter.
+//
+// That makes the failure readable, but only against numbers no other line reports,
+// and only at the instant it happened. P2 RETRY re-asks the same requests from the
+// digest, after the run: it measures the heap the run left behind. This records the
+// heap the run failed in, which is the state no later probe can reconstruct.
+//
+// Two comparisons decide the question:
+//
+//   big against np  -- whether a run of the requested size existed. `big` is the
+//                      largest run the same search would have accepted, computed
+//                      with the same MaxAddress, MinAddress and alignment, so
+//                      big < np is a statement about the map and big >= np is a
+//                      statement about this census.
+//   raw against big -- if none was big enough, whether the alignment clip ate one.
+//                      `raw` is the largest descriptor before the clip. For
+//                      EfiBootServicesCode the clip is one page and the two are
+//                      equal, which is itself the evidence that alignment is not
+//                      the factor for the 27; for the runtime types it is 16 pages
+//                      and the difference is the loss.
+//
+// `free` is every conventional page in the map, and it is the number that separates
+// a heap that is full from a heap that is a sieve: the same `free` beside a small
+// `big` is fragmentation, which no promotion fixes, while a `free` near zero is the
+// bin question P2 BIN was built for. `c`, the descriptor count, is what makes
+// "fragmentation" a measurement rather than an adjective.
+//
+// The tally by type exists to falsify one assumption cheaply. Every one of the 27 is
+// believed to be an EfiBootServicesCode request, on the grounds that the memory type
+// comes from the PE subsystem and not from the relocation fallback (Image.c:629-646)
+// and only 10 of the 46 promoted images are subsystem-12. `bc` against `bd` and `rt`
+// prints that belief as a count instead of leaving it to a reading of the source.
+//
+// Only the first image-sized failure is described. A pool chunk below four pages
+// failing is a different event and the wrong one to describe, and after the first
+// page-sized failure the map is already being read under a handicap - the run that
+// produced the first one is the run to explain.
+//
+STATIC BOOLEAN  mP2FwSeen  = FALSE;
+STATIC UINTN    mP2FwCount = 0;
+STATIC UINTN    mP2FwTy[4] = { 0, 0, 0, 0 };
+STATIC UINTN    mP2FwType  = 0;
+STATIC UINT64   mP2FwPages = 0;
+STATIC UINTN    mP2FwAlign = 0;
+STATIC UINT64   mP2FwBig   = 0;
+STATIC UINT64   mP2FwRaw   = 0;
+STATIC UINT64   mP2FwFree  = 0;
+STATIC UINTN    mP2FwDesc  = 0;
+
+STATIC
+VOID
+P2FreeWhy (
+  IN UINT64           MaxAddress,
+  IN UINT64           NumberOfPages,
+  IN EFI_MEMORY_TYPE  NewType,
+  IN UINTN            Alignment
+  )
+{
+  LIST_ENTRY  *Link;
+  MEMORY_MAP  *Entry;
+  UINT64      RunBytes;
+  UINT64      DescStart;
+  UINT64      DescEnd;
+  UINT64      DescBytes;
+  UINTN       Slot;
+
+  if (NewType == EfiBootServicesCode) {
+    Slot = 0;
+  } else if (NewType == EfiBootServicesData) {
+    Slot = 1;
+  } else if ((NewType == EfiRuntimeServicesCode) || (NewType == EfiRuntimeServicesData)) {
+    Slot = 2;
+  } else {
+    Slot = 3;
+  }
+
+  mP2FwCount++;
+  mP2FwTy[Slot]++;
+
+  if (mP2FwSeen || (NumberOfPages < 4)) {
+    return;
+  }
+
+  mP2FwSeen  = TRUE;
+  mP2FwType  = (UINTN)NewType;
+  mP2FwPages = NumberOfPages;
+  mP2FwAlign = Alignment;
+
+  //
+  // The canonicalisation CoreFindFreePagesI does before its loop, so that `big` is
+  // measured against the same ceiling the search used.
+  //
+  if ((MaxAddress & EFI_PAGE_MASK) != EFI_PAGE_MASK) {
+    MaxAddress -= (EFI_PAGE_MASK + 1);
+    MaxAddress &= ~(UINT64)EFI_PAGE_MASK;
+    MaxAddress |= EFI_PAGE_MASK;
+  }
+
+  for (Link = gMemoryMap.ForwardLink; Link != &gMemoryMap; Link = Link->ForwardLink) {
+    Entry = CR (Link, MEMORY_MAP, Link, MEMORY_MAP_SIGNATURE);
+
+    if (Entry->Type != EfiConventionalMemory) {
+      continue;
+    }
+
+    if ((Entry->Attribute & EFI_MEMORY_SP) != 0) {
+      continue;
+    }
+
+    mP2FwDesc++;
+
+    RunBytes = Entry->End - Entry->Start + 1;
+    mP2FwFree += RShiftU64 (RunBytes, EFI_PAGE_SHIFT);
+    if (RunBytes > mP2FwRaw) {
+      mP2FwRaw = RunBytes;
+    }
+
+    DescStart = Entry->Start;
+    DescEnd   = Entry->End;
+    if (DescEnd >= MaxAddress) {
+      DescEnd = MaxAddress;
+    }
+
+    DescEnd = ((DescEnd + 1) & (~((UINT64)Alignment - 1))) - 1;
+    if (DescEnd < DescStart) {
+      continue;
+    }
+
+    DescBytes = DescEnd - DescStart + 1;
+    if (DescBytes > mP2FwBig) {
+      mP2FwBig = DescBytes;
+    }
+  }
