+    return 'R';
+  }
+
+  if (Status == EFI_NOT_FOUND) {
+    return 'N';
+  }
+
+  if (Status == EFI_SECURITY_VIOLATION) {
+    return 'X';
+  }
+
+  if (Status == EFI_DEVICE_ERROR) {
+    return 'D';
+  }
+
+  if (Status == EFI_LOAD_ERROR) {
+    return 'E';
+  }
+
+  if (Status == EFI_INVALID_PARAMETER) {
+    return 'P';
+  }
+
+  if (Status == EFI_UNSUPPORTED) {
+    return 'U';
+  }
+
+  return 'O';
