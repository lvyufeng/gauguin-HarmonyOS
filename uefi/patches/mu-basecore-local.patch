   Internal function.  Finds a consecutive free page range below
   the requested address
@@ -1127,6 +1329,14 @@ FindFreePages (
   // If allocations from the preferred bins fail, then attempt to promote memory resources.
   //
   if (!PromoteMemoryResource ()) {
+    //
+    // P2BRINGUP: the one place a failure becomes terminal, and therefore the only
+    // place the free map is worth describing. On the recursive path this is the
+    // second refusal - promotion succeeded, the retry searched the enlarged map,
+    // and it is still too small - which is the same statement with the promoted
+    // regions already counted in.
+    //
+    P2FreeWhy (MaxAddress, NoPages, NewType, Alignment);
     return 0;
   }
 
